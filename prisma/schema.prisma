generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model Admin {
  id        String   @id @default(cuid()) @map("_id")
  username  String   @unique
  email     String?  @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsCategory {
  id    String @id @default(cuid()) @map("_id")
  name  String @unique
  slug  String @unique
  news  News[]
}

model News {
  id         String        @id @default(cuid()) @map("_id")
  title      String
  slug       String        @unique
  excerpt    String?
  content    String       
  image      String?
  images     String[]      @default([])
  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id])
  tags       String[]      @default([])
  author     String?       @default("Ma'muriyat")
  views      Int           @default(0)
  published  Boolean       @default(true)
  featured   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([createdAt])
}

model Teacher {
  id         String   @id @default(cuid()) @map("_id")
  fullName   String
  slug       String   @unique
  subject    String
  category   String?
  experience Int?
  photo      String?
  bio        String? 
  phone      String?
  email      String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subject])
  @@index([published])
}

model Administration {
  id        String   @id @default(cuid()) @map("_id")
  fullName  String
  position  String
  photo     String?
  bio       String? 
  phone     String?
  email     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  slug        String   @unique
  description String  
  date        DateTime
  time        String?
  location    String?
  image       String?
  status      String   @default("upcoming")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

model Achievement {
  id          String    @id @default(cuid()) @map("_id")
  title       String
  description String?  
  category    String
  image       String?
  date        DateTime?
  studentName String?
  level       String?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([published])
}

model Gallery {
  id          String         @id @default(cuid()) @map("_id")
  title       String
  slug        String         @unique
  description String?       
  category    String?
  coverImage  String?
  published   Boolean        @default(true)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([published])
}

model GalleryImage {
  id        String   @id @default(cuid()) @map("_id")
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id])
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([galleryId])
}

model Document {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  category  String?
  fileUrl   String
  fileName  String?
  fileSize  Int?
  fileType  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model Feedback {
  id        String   @id @default(cuid()) @map("_id")
  firstName String
  lastName  String
  phone     String
  email     String?
  subject   String
  message   String  
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Schedule {
  id        String   @id @default(cuid()) @map("_id")
  className String
  dayOfWeek Int
  period    Int
  subject   String
  teacher   String?
  room      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([className, dayOfWeek])
}

model Translation {
  id        String   @id @default(cuid()) @map("_id")
  key       String
  locale    String
  value     String  
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
}

model SiteSettings {
  id                String   @id @default("site") @map("_id")
  siteName          String   @default("Chortoq tumani 6-sonli umumiy o'rta ta'lim maktabi")
  siteDescription   String? 
  aboutText         String? 
  logo              String?
  heroImage         String?
  address           String?
  phone             String?
  email             String?
  workHours         String?
  telegram          String?
  instagram         String?
  facebook          String?
  youtube           String?
  mapEmbed          String? 
  studentsCount     Int?
  teachersCount     Int?
  classesCount      Int?
  achievementsCount Int?
  clubsCount        Int?
  updatedAt         DateTime @updatedAt
}
